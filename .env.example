APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# HTTP protection; use Redis or a shared database store for multiple servers.
HTTP_RATE_LIMIT_PER_MINUTE=600
# RATE_LIMIT_STORE=redis
HSTS_MAX_AGE=31536000
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_IP_RATE_LIMIT_PER_MINUTE=20
# Explicit browser origins, separated by commas. Empty permits no cross-origin clients.
CORS_ALLOWED_ORIGINS=

APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"

HEADQUARTERS_APPROVAL_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=shadaibucket
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BIBLE_API=
BIBLE_API_CA_BUNDLE=
BIBLE_API_CONNECT_TIMEOUT=5
BIBLE_API_TIMEOUT=10

HQ_API_URL=http://127.0.0.1:8011/api
HQ_API_KEY_ID=apishadai
HQ_API_SIGNING_SECRET=
HQ_PUBLISHING_ENABLED=true
HQ_SEND_IMMEDIATELY=true
AWS_ENDPOINT=https://cellar-c2.services.clever-cloud.com
IMAGE_STORAGE_ENABLED=true
IMAGE_STORAGE_DISK=s3
IMAGE_STORAGE_PREFIX=shadmin/images
INVOICE_STORAGE_PREFIX=invoices
IMAGE_STORAGE_URL_MINUTES=720
AWS_CA_BUNDLE=

# Optional absolute path. Default: storage/app/private/desktop-license-signing.pem
# DESKTOP_LICENSE_PRIVATE_KEY_PATH=

# Private desktop packages. Existing Cellar credentials stay on the backend.
DESKTOP_UPDATE_STORAGE_ENABLED=false
DESKTOP_UPDATE_API_ENABLED=false
DESKTOP_UPDATE_BUCKET=shadai-updates
DESKTOP_UPDATE_PREFIX=desktop-updates
DESKTOP_UPDATE_URL_SECONDS=3600
DESKTOP_UPDATE_MAX_BYTES=1073741824
# Optional dedicated Cellar identity; never copy credentials into desktop apps.
# DESKTOP_UPDATE_ACCESS_KEY_ID=
# DESKTOP_UPDATE_SECRET_ACCESS_KEY=
# DESKTOP_UPDATE_ENDPOINT=https://cellar-c2.services.clever-cloud.com
# DESKTOP_UPDATE_REGION=us-east-1
