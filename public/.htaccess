# Also configure ServerTokens Prod, TraceEnable Off and expose_php=Off at server level.
ServerSignature Off

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header unset X-AspNet-Version
    Header always unset X-AspNet-Version
    Header unset X-AspNetMvc-Version
    Header always unset X-AspNetMvc-Version
    Header unset X-Debug-Token
    Header always unset X-Debug-Token
    Header unset X-Debug-Token-Link
    Header always unset X-Debug-Token-Link
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteCond %{REQUEST_METHOD} ^(?:TRACE|TRACK)$ [NC]
    RewriteRule ^ - [R=405,L]

    # Forzar HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Mantener Authorization header (necesario para JWT/Bearer)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Solo permitir rutas que empiecen con /api/
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteRule ^ - [F]

    # Quitar trailing slash si no es un directorio
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Enviar /api/... al front controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
